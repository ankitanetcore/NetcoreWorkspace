# HTTP server and WebSocket (/ws) share this port.
PORT=8082

# Loopback only. Set HOST=0.0.0.0 to accept other machines on the LAN.
# HOST=127.0.0.1

# Extra hostnames for a tunnel or reverse proxy, comma-separated.
# The server still rejects every other name, including a wildcard.
# ALLOWED_HOSTS=workspace.example

# Database and uploaded files for this instance.
# Relative paths start at the repository root. Give each instance its own directory.
DATA_DIR=server/data

EXPO_PUBLIC_TURN_HOSTS=
EXPO_PUBLIC_TURN_USERNAME=
EXPO_PUBLIC_TURN_CREDENTIAL=
